{
  "name": "@morpho-org/quoter",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "morpho-quoter": "./dist/src/index.js"
  },
  "type": "module",
  "scripts": {
    "bench:step-cost": "vitest run --config vitest.bench.config.ts",
    "build": "tsx scripts/build.ts",
    "jsdoc:check": "tsx scripts/check-jsdoc.ts",
    "prenpm:pack": "bun run --filter @repo/contracts build && bun run build",
    "npm:pack": "tsx scripts/pack-npm.ts",
    "prestart": "bun run --filter @repo/contracts build && bun run build",
    "playground:build": "node scripts/playground-build.mjs",
    "playground:serve": "node scripts/playground-serve.mjs",
    "playground:serve:test": "node --test scripts/playground-atomic-publish.test.mjs scripts/playground-build.test.mjs scripts/playground-process.test.mjs scripts/playground-serve.test.mjs",
    "playground:smoke": "node scripts/playground-smoke.mjs",
    "playground:smoke:output-probe": "node scripts/playground-smoke-output-probe.mjs",
    "playground:smoke:test": "node --test scripts/playground-smoke.browser.mjs",
    "playground:test": "node --test scripts/playground-atomic-publish.test.mjs scripts/playground-build.test.mjs scripts/playground-process.test.mjs scripts/playground-serve.test.mjs scripts/playground-smoke-suite.test.mjs scripts/playground-smoke.test.mjs",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "test:e2e": "vitest run test/e2e",
    "typecheck": "soltag && tsc --noEmit"
  },
  "dependencies": {
    "@morpho-org/midnight-sdk": "catalog:",
    "@morpho-org/morpho-sdk": "5.7.0",
    "@morpho-org/morpho-ts": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@repo/contracts": "workspace:*",
    "@repo/controller": "workspace:*",
    "@repo/engine": "workspace:*",
    "@repo/kernel": "workspace:*",
    "@repo/kit": "workspace:*",
    "@repo/offers": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/validators": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-table": "catalog:",
    "commander": "15.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "solc": "catalog:",
    "soltag": "catalog:",
    "viem": "catalog:",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "2.12.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "execa": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
